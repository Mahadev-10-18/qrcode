# Database configuration (PostgreSQL)
# Option A: Full Connection String (Recommended for hosted databases like Render, Supabase, Neon)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname
DATABASE_SSL=True # Set to True to enable SSL connection (e.g. for Render/Neon PostgreSQL)

# Option B: Individual variables (fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lostitem
USE_SQLITE=False

# Twilio Proxy settings (for SMS and Call Relay)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=00000000000000000000000000000000
TWILIO_PROXY_SERVICE_SID=KS00000000000000000000000000000000
TWILIO_PHONE_NUMBER=+15551234567

# App domains
APP_DOMAIN=https://backend.onrender.com  # The base URL of the FastAPI backend (with https:// in production)
FRONTEND_URL=https://frontend.vercel.app # The base URL of the React frontend (with https:// in production)
QR_BASE_URL=https://frontend.vercel.app  # Base URL used for printed/scannable QR codes (points to frontend)

# Application Environment settings
APP_ENV=production          # "development", "production", or "test"
SECRET_KEY=yoursecretkeyhere # Secure key for signing JWT tokens
ALLOW_LEGACY_AUTH=False
ENABLE_DB_AUTO_CREATE=False # Set to False in production, database schemas will be created by migrations

# JWT expirations
VERIFICATION_TOKEN_EXPIRE_HOURS=48
RESET_TOKEN_EXPIRE_MINUTES=60

# Email configurations (SMTP)
EMAIL_FROM=hello@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@yourdomain.com
SMTP_PASSWORD=yourapppassword

# Redis and Caching configurations
REDIS_URL=memory # Use "redis://username:password@host:port" or "memory" for in-memory mockup fallback

# Sentry Monitoring
SENTRY_DSN=

# Google OAuth Credentials (for sign-in integrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
